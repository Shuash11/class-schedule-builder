rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ====================================================================
    // DEMO MODE — NON-PRODUCTION. There is NO sign-in in this app.
    // These rules intentionally allow ANY client with the project's public
    // web config to read, create, update and delete schedule data.
    // DO NOT deploy these rules to a production project or store private
    // data here. Field checks below protect data shape, not confidentiality.
    // ====================================================================

    function validTime(t) {
      return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validSubjectData(d) {
      return d.user_id is string
        && d.subject_code is string && d.subject_code.size() >= 1 && d.subject_code.size() <= 20
        && d.subject_name is string && d.subject_name.size() >= 1 && d.subject_name.size() <= 80
        && (d.instructor == null || (d.instructor is string && d.instructor.size() <= 80))
        && (d.room == null || (d.room is string && d.room.size() <= 40))
        && d.color in ['#615fff', '#8e51ff', '#00a6f4', '#00bba7', '#00bc7d',
                       '#fe9a00', '#ff6900', '#ff2056', '#6366f1'];
    }

    function validSessionData(d) {
      return d.user_id is string
        && d.subject_id is string
        && d.day_of_week is int && d.day_of_week >= 0 && d.day_of_week <= 6
        && validTime(d.start_time) && validTime(d.end_time)
        && d.start_time < d.end_time;
    }

    match /subjects/{subjectId} {
      allow read, delete: if true;
      allow create, update: if validSubjectData(request.resource.data);
    }

    match /class_sessions/{sessionId} {
      allow read, delete: if true;
      allow create, update: if validSessionData(request.resource.data);
    }
  }
}
