rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ====================================================================
    // DEMO MODE — NON-PRODUCTION. Login is backed by Firestore documents
    // (users + sessions), NOT Firebase Auth. These rules intentionally allow
    // ANY client with the project's public web config to read, create, update
    // and delete ALL data — including password hashes. Field checks below
    // protect data shape, not confidentiality. DO NOT use for private data.
    // ====================================================================

    function validTime(t) {
      return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validSubjectData(d) {
      return d.user_id is string
        && d.subject_code is string && d.subject_code.size() >= 1 && d.subject_code.size() <= 20
        && d.subject_name is string && d.subject_name.size() >= 1 && d.subject_name.size() <= 80
        && (d.instructor == null || (d.instructor is string && d.instructor.size() <= 80))
        && (d.room == null || (d.room is string && d.room.size() <= 40))
        && d.color in ['#615fff', '#8e51ff', '#00a6f4', '#00bba7', '#00bc7d',
                       '#fe9a00', '#ff6900', '#ff2056', '#6366f1'];
    }

    function validSessionData(d) {
      return d.user_id is string
        && d.subject_id is string
        && d.day_of_week is int && d.day_of_week >= 0 && d.day_of_week <= 6
        && validTime(d.start_time) && validTime(d.end_time)
        && d.start_time < d.end_time;
    }

    match /subjects/{subjectId} {
      allow read, delete: if true;
      allow create, update: if validSubjectData(request.resource.data);
    }

    match /class_sessions/{sessionId} {
      allow read, delete: if true;
      allow create, update: if validSessionData(request.resource.data);
    }

    // Firestore-backed demo login (no Firebase Auth). Password hashes and
    // session records are readable by anyone with the public config — demo
    // only, never store real credentials here.
    function validUserData(d) {
      return d.email is string
        && d.salt is string && d.salt.size() >= 16
        && d.password_hash is string && d.password_hash.size() >= 32;
    }

    function validLoginSessionData(d) {
      return d.user_id is string && d.user_id.size() >= 1;
    }

    match /users/{userId} {
      allow read, delete: if true;
      allow create, update: if validUserData(request.resource.data);
    }

    match /sessions/{token} {
      allow read, delete: if true;
      allow create, update: if validLoginSessionData(request.resource.data);
    }
  }
}
